#!/usr/bin/env bash
# jj-stamp: rewrite a commit's COMMITTER timestamp.
#
#   jj-stamp <rev>            -- set committer time to the commit's AUTHOR time
#   jj-stamp <rev> <TIME>     -- set committer time to TIME (RFC 3339, e.g.
#                                2026-08-11T09:00:00+02:00)
#
# jj stamps the COMMITTER timestamp "now" on every rewrite while preserving the
# AUTHOR timestamp, but GitHub shows the committer date. This rewrites the
# commit's committer time (content, parents, description, and author unchanged)
# via JJ_TIMESTAMP (the debug.commit-timestamp override, RFC 3339). jj skips
# commits whose metadata is unchanged, so the description is toggled and restored.
set -e

case "${1:-}" in
  -h|--help|help)
    echo "usage: jj stamp <rev> [<TIME>]"
    echo
    echo "Rewrite a commit's COMMITTER timestamp."
    echo "  jj stamp <rev>          set committer time to the commit's AUTHOR time"
    echo "  jj stamp <rev> <TIME>   set committer time to TIME (RFC 3339, e.g. 2026-08-11T09:00:00+02:00)"
    echo
    echo "Preserves content, parents, description, and author. Uses JJ_TIMESTAMP"
    echo "(the debug.commit-timestamp override). Toggles the description to force a"
    echo "rewrite, then restores it."
    exit 0
    ;;
esac

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  echo "usage: jj-stamp <rev> [<TIME>]" >&2
  exit 1
fi
rev=$1
time=${2:-}

if [ -z "$time" ]; then
  time=$(jj log --no-pager -r "$rev" -T 'author.timestamp().format("%Y-%m-%dT%H:%M:%S%:z")' --no-graph | tr -d ' \r')
fi

desc=$(jj log --no-pager -r "$rev" -T description --no-graph)

JJ_TIMESTAMP="$time" jj describe -r "$rev" -m '__jj_stamp__' >/dev/null
JJ_TIMESTAMP="$time" jj describe -r "$rev" -m "$desc" >/dev/null
