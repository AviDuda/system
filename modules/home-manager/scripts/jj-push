#!/usr/bin/env bash
# jj-push: move the trunk bookmark to the topmost PUBLIC (non-local) commit and
# push it. Private/local commits (LOCAL:/wip:/private:) are never pushed.
#
# The bare `jj git push`/`jj bookmark advance` can land the bookmark on a
# LOCAL/wip/private head. This instead advances the bookmark only to the topmost
# public commit (never a local head), so private commits stay unpushed, then
# pushes. Signing happens via git.sign-on-push; GitHub shows the normal git
# committer (push) date.
#
# Why we don't try to preserve the real per-commit dates: jj bumps the committer
# to "now" on every rewrite (rebase/sign), and GitHub renders the committer date.
# So any rebase or push of a stacked run collapses every commit's shown date to
# the push instant. Making the committer equal the author only survives for a
# lone leaf commit -- for a real stack (the common case here, with private
# commits above) sign-on-push re-signs and resets it anyway. And when it does
# survive, a fresh commit shows its author time (= when the change was created,
# possibly an auto-created empty change), which can make a just-pushed commit
# look hours old. So we accept git's normal committer date: a batch you push
# shows the push time, which is what git users expect.
#
# --dry-run: report what would be pushed without advancing the bookmark or
# pushing.
set -e

case "${1:-}" in
  -h|--help|help)
    echo "usage: jj push [--no-advance] [--dry-run]"
    echo
    echo "Push the trunk() bookmark after moving it to the topmost public commit"
    echo "so private/local commits are never pushed. Signing happens via"
    echo "git.sign-on-push; GitHub shows the normal git committer (push) date."
    echo "  --no-advance   leave the trunk bookmark where it is; push its current"
    echo "                 position (no bookmark move)"
    echo "  --dry-run      report what would be pushed without moving anything, or"
    echo "                 pushing"
    exit 0
    ;;
esac

dry_run=0
advance=1
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=1 ;;
    --no-advance) advance=0 ;;
  esac
done

PRIV=$(jj config get git.private-commits 2>/dev/null || true)
ST='::@ & mutable() & ~::trunk() & ~empty()'
if [ -n "$PRIV" ]; then
  PUB="$ST & ~($PRIV)"
else
  PUB="$ST"
fi
BM=$(jj bookmark list -r 'trunk()' | awk -F: 'NR==1{print $1}' | tr -d ' ')
PHEAD=$(jj log --no-pager -r "latest($PUB, 1)" -T change_id --no-graph | tr -d ' ')

if [ -z "$BM" ]; then
  echo "No trunk() bookmark; nothing to push." >&2
  exit 1
fi

if [ "$dry_run" -eq 0 ]; then
  # move the bookmark to the topmost public commit (not a local head); skip with --no-advance
  if [ "$advance" -eq 1 ] && [ -n "$PHEAD" ]; then
    jj bookmark set "$BM" -r "$PHEAD"
  fi
fi

if [ "$dry_run" -eq 1 ]; then
  jj git push --bookmark "$BM" --dry-run
else
  jj git push --bookmark "$BM"
fi
